# --- OpenRouter (single gateway for all chat models) ---
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- OpenAI (only used for embeddings on RAG) ---
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Supabase (cloud — supabase.com project) ---
# Project Settings -> API. URL looks like https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Use your Vercel production URL once deployed (e.g. https://omniscient.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: override default classifier/embedding models ---
CLASSIFIER_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-3-small
